{
  "name": "privacv",
  "version": "0.1.0",
  "private": true,
  "description": "PrivaCV — private, local-first tools for resumes and job applications.",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "check:deploy": "pnpm build:cloudflare && node scripts/check-worker-size.mjs",
    "dev": "next dev",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:build": "node desktop/prepare-next.mjs",
    "desktop:package": "pnpm desktop:build && electron-forge package",
    "desktop:make": "pnpm desktop:build && electron-forge make",
    "desktop:smoke": "node desktop/smoke.mjs",
    "start": "next start",
    "lint": "oxlint --report-unused-disable-directives .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:public-resumes": "node scripts/fetch-public-resume-fixtures.mjs && PLAYWRIGHT_PUBLIC_RESUMES=1 playwright test tests/public-resume-import.spec.ts",
    "test:e2e": "playwright test",
    "preview": "pnpm build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "pnpm build:cloudflare && opennextjs-cloudflare deploy",
    "upload": "pnpm build:cloudflare && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@internationalized/date": "^3.12.3",
    "@mlc-ai/web-llm": "^0.2.84",
    "@opennextjs/cloudflare": "^1.20.4",
    "@react-pdf/renderer": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.35.0",
    "next": "^16.3.3",
    "pdfjs-dist": "6.2.108",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-resizable-panels": "^4.12.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.2.0",
    "jsdom": "^29.1.1",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "postcss": "8.5.20",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@11.15.1"
}
