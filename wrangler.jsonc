{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "privacv",
  "routes": [
    {
      "pattern": "privacv.app",
      "custom_domain": true,
    },
    {
      "pattern": "www.privacv.app",
      "custom_domain": true,
    },
  ],
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "privacv",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HANDOFF_ROOMS",
        "class_name": "WebRTCHandoffRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-handoff-rooms",
      "new_sqlite_classes": ["WebRTCHandoffRoom"],
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "VISITOR_METRICS",
      "dataset": "privacv_visitors",
    },
    {
      "binding": "EXPORT_METRICS",
      "dataset": "privacv_exports",
    },
    {
      "binding": "INLINE_AI_METRICS",
      "dataset": "privacv_inline_ai",
    },
    {
      "binding": "JOB_APPLICATION_METRICS",
      "dataset": "privacv_job_applications",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
